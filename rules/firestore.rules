rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profile photo: empty, an http(s)/extension URL or an inline image, made only of
    // URL characters (no quotes, angle brackets or whitespace that could break out of
    // an HTML attribute on other users' pages).
    function isSafePhotoUrl(value) {
      return value == null || value == '' ||
        (value is string &&
          value.matches('^(https?://|chrome-extension://|data:image/(png|jpe?g|gif|webp);base64,)[A-Za-z0-9._~:/?#@!$&()*+,;=%-]*$'));
    }
    
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Self-edited profile fields shown on other users' pages. Only values that an
    // update actually changes are checked, so legacy documents keep working.
    function isValidProfileFieldUpdate() {
      let data = request.resource.data;
      let keys = changedKeys();
      return (!keys.hasAny(['bannerURL']) || !('bannerURL' in data) || isSafePhotoUrl(data.bannerURL))
        && (!keys.hasAny(['username']) || (data.username is string && data.username.matches('^[A-Za-z0-9_]{3,20}$')))
        && (!keys.hasAny(['usernameLower']) || (data.usernameLower is string && data.usernameLower == data.username.lower()))
        && (!keys.hasAny(['firstName']) || (data.firstName is string && data.firstName.size() <= 50))
        && (!keys.hasAny(['lastName']) || (data.lastName is string && data.lastName.size() <= 50))
        && (!keys.hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 200))
        && (!keys.hasAny(['bio']) || (data.bio is string && data.bio.size() <= 200))
        && (!keys.hasAny(['displayNameFormat']) || data.displayNameFormat in ['fullname', 'username'])
        // Pinned top-5 favorites shown on the profile.
        && (!keys.hasAny(['pinnedMovies']) || (data.pinnedMovies is list && data.pinnedMovies.size() <= 5))
        // Achievement tiers and points, recomputed by the owner's client.
        && (!keys.hasAny(['achievements']) || (data.achievements is map && data.achievements.size() <= 64))
        && (!keys.hasAny(['achievementPoints']) || (data.achievementPoints is int && data.achievementPoints >= 0))
        && (!keys.hasAny(['showRankFrame']) || data.showRankFrame is bool)
        && (!keys.hasAny(['rankFrameLevel']) || !('rankFrameLevel' in data)
          || (data.rankFrameLevel is int && data.rankFrameLevel >= 1 && data.rankFrameLevel <= 7));
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if user is approved (or unmigrated legacy fallback)
    function isApprovedUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved' ||
               // TODO-remove-after-migration-confirmed: Fallback for unmigrated legacy docs.
               // The users create rule now requires approvalStatus == 'pending', so only
               // documents created before that rule can still lack the field. Remove this
               // branch once no user document without approvalStatus remains.
               !('approvalStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
             );
    }

    // New list entries must belong to the signed-in user, and an owner may not
    // hand an existing entry to another user.
    function isOwnListEntryCreate() {
      return isApprovedUser() && request.resource.data.userId == request.auth.uid;
    }

    function isOwnListEntryChange() {
      return isApprovedUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // Reports may be sent by guests, so the payload is bounded instead of open.
    function isValidReportPayload(data) {
      return data.keys().hasOnly([
          'text', 'photoUrl', 'photoPath', 'status', 'createdAt', 'userId', 'pageUrl',
          'targetType', 'targetRatingId', 'targetMovieId', 'targetAuthorId'
        ])
        && data.text is string && data.text.size() <= 5000
        && data.status == 'pending'
        && data.createdAt == request.time
        && (data.userId == null || (isAuthenticated() && data.userId == request.auth.uid))
        && (data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (data.photoPath == null || (data.photoPath is string && data.photoPath.size() <= 512))
        && data.pageUrl is string && data.pageUrl.size() <= 2048;
    }

    function isValidRatingData(data) {
      return data.userId is string
        && data.movieId is int && data.movieId > 0
        && data.rating is int && data.rating >= 1 && data.rating <= 10
        && (!('ratingSource' in data) || data.ratingSource in ['episodes', 'manual'])
        && (!('episodeAverage' in data) || data.episodeAverage is number
          && data.episodeAverage >= 1 && data.episodeAverage <= 10)
        && (!('episodesRatedCount' in data) || data.episodesRatedCount is int
          && data.episodesRatedCount >= 1 && data.episodesRatedCount <= 3000)
        && data.comment is string && data.comment.size() <= 500
        && (!('review' in data) || data.review is string && data.review.size() <= 5000)
        && (!('contentUpdatedAt' in data) || data.contentUpdatedAt is timestamp)
        && (!('userName' in data) || data.userName is string && data.userName.size() <= 120)
        && (!('userPhoto' in data) || data.userPhoto is string && data.userPhoto.size() <= 2048)
        && (!('movieTitle' in data) || data.movieTitle is string && data.movieTitle.size() <= 300)
        && (!('posterPath' in data) || data.posterPath is string && data.posterPath.size() <= 2048)
        && (!('isFavorite' in data) || data.isFavorite is bool);
    }

    function isTextOnlyRatingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'comment', 'review', 'contentUpdatedAt', 'userName', 'userPhoto'
      ])
      && request.resource.data.userId == resource.data.userId
      && request.resource.data.movieId == resource.data.movieId
      && request.resource.data.rating == resource.data.rating;
    }

    function seriesEpisodeRatingPath(seriesRatingId) {
      return /databases/$(database)/documents/seriesEpisodeRatings/$(seriesRatingId);
    }

    function hasOwnSeriesEpisodeRatingId(seriesRatingId) {
      return isAuthenticated()
        && seriesRatingId.matches('^' + request.auth.uid + '_[0-9]+$');
    }

    function isValidEpisodeRatingEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['r', 't', 'id'])
        && entry.r is int && entry.r >= 1 && entry.r <= 10
        && entry.t is timestamp
        && (!('id' in entry) || entry.id is int && entry.id > 0);
    }

    function isValidSeriesEpisodeRatingData(seriesRatingId, data) {
      return data.keys().hasOnly([
          'userId', 'movieId', 'tmdbId', 'episodes', 'lastKey', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == request.auth.uid
        && data.movieId is int && data.movieId > 0
        && seriesRatingId == request.auth.uid + '_' + string(data.movieId)
        && (data.tmdbId == null || data.tmdbId is int && data.tmdbId > 0)
        && data.episodes is map && data.episodes.size() >= 1 && data.episodes.size() <= 3000
        && data.lastKey is string
        && data.lastKey.matches('^[0-9]{1,3}:[0-9]{1,5}$')
        && data.updatedAt is timestamp;
    }

    function hasOneValidEpisodeRatingChange() {
      let changedEpisodes = request.resource.data.episodes.diff(resource.data.episodes).affectedKeys();
      return changedEpisodes.size() <= 1
        && changedEpisodes.hasOnly([request.resource.data.lastKey])
        && (!request.resource.data.episodes.keys().hasAny([request.resource.data.lastKey])
          || isValidEpisodeRatingEntry(request.resource.data.episodes[request.resource.data.lastKey]));
    }

    function hasReviewReportTarget(data) {
      return data.keys().hasAny([
        'targetType', 'targetRatingId', 'targetMovieId', 'targetAuthorId'
      ]);
    }

    function isValidReviewReport(data) {
      let ratingPath = /databases/$(database)/documents/ratings/$(data.targetRatingId);
      return data.targetType == 'rating-review'
        && data.targetRatingId is string
        && data.targetMovieId is int && data.targetMovieId > 0
        && data.targetAuthorId is string
        && exists(ratingPath)
        && get(ratingPath).data.review is string
        && get(ratingPath).data.review.size() > 0
        && string(get(ratingPath).data.movieId) == string(data.targetMovieId)
        && get(ratingPath).data.userId == data.targetAuthorId;
    }

    function hasCanonicalRatingId(ratingId, data) {
      return ratingId == request.auth.uid + '_' + string(data.movieId);
    }

    function commentReactionConfigPath() {
      return /databases/$(database)/documents/settings/commentReactions;
    }

    function commentReactionPath(reactionId) {
      return /databases/$(database)/documents/commentReactions/$(reactionId);
    }

    function hasOwnCommentReactionId(reactionId) {
      return isAuthenticated()
        && reactionId.matches('^.+_' + request.auth.uid + '$');
    }

    function commentReactionAllowedTypes() {
      return exists(commentReactionConfigPath())
        && get(commentReactionConfigPath()).data.reactionTypes is list
        ? get(commentReactionConfigPath()).data.reactionTypes
        : ['like', 'love', 'laugh', 'wow', 'sad', 'fire', 'clap', 'rocket', 'party', 'thinking', 'eyes', 'hundred'];
    }

    function isValidCommentReactionType(reactionType) {
      return reactionType in commentReactionAllowedTypes();
    }

    function isValidCommentReactionMovieId(movieId) {
      return (movieId is number && movieId > 0)
        || (movieId is string && movieId.size() > 0);
    }

    function ratingHasMovie(ratingId, movieId) {
      let ratingPath = /databases/$(database)/documents/ratings/$(ratingId);
      return exists(ratingPath)
        && get(ratingPath).data.movieId != null
        && string(get(ratingPath).data.movieId) == string(movieId);
    }

    function isValidCommentReactionSelection(data) {
      return (('types' in data
        && data.types is list
        && data.types.size() > 0
        && data.types.size() <= 3
        && data.types.hasOnly(commentReactionAllowedTypes())
        && (!('type' in data) || isValidCommentReactionType(data.type)))
        || (!('types' in data)
          && 'type' in data
          && isValidCommentReactionType(data.type)));
    }

    function isValidSharedIdMapping(mappingId, data) {
      return data.keys().hasOnly([
          'tmdbId', 'mediaType', 'kpId', 'kpType', 'title', 'year', 'status',
          'identityStatus', 'verificationMethod', 'verificationSource',
          'resolutionSource', 'isManual', 'reverseKey', 'confirmedBy', 'updatedBy',
          'createdAt', 'updatedAt', 'resolvedAt'
        ])
        && data.tmdbId is int && data.tmdbId > 0
        && data.kpId is int && data.kpId > 0
        && data.mediaType in ['movie', 'tv']
        && mappingId == data.mediaType + ':' + string(data.tmdbId)
        && data.reverseKey == 'kp:' + data.mediaType + ':' + string(data.kpId)
        && (data.kpType == null || data.kpType is string)
        && data.title is string
        && (data.year == null || data.year is int)
        && data.status == 'resolved'
        && data.identityStatus == 'VERIFIED'
        && data.verificationMethod == 'admin_verified'
        && data.verificationSource == 'manual'
        && data.resolutionSource == 'manual'
        && data.isManual == true
        && data.confirmedBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.resolvedAt is number;
    }

    // The reverse record is a transactional uniqueness lock, not a second
    // mapping authority. It makes one Kinopoisk ID claimable by one TMDB ID.
    function sharedMappingPath(mappingId) {
      return /databases/$(database)/documents/tmdbKinopoiskMappings/$(mappingId);
    }

    function sharedReversePath(reverseKey) {
      return /databases/$(database)/documents/tmdbKinopoiskReverseIndex/$(reverseKey);
    }

    function isValidSharedReverseLock(reverseKey, data) {
      return data.keys().hasOnly([
          'reverseKey', 'mappingId', 'tmdbId', 'mediaType', 'kpId', 'updatedAt'
        ])
        && data.reverseKey == reverseKey
        && data.tmdbId is int && data.tmdbId > 0
        && data.kpId is int && data.kpId > 0
        && data.mediaType in ['movie', 'tv']
        && data.mappingId == data.mediaType + ':' + string(data.tmdbId)
        && reverseKey == 'kp:' + data.mediaType + ':' + string(data.kpId)
        && data.updatedAt is timestamp;
    }

    function hasSharedReverseLock(mappingId, mappingData) {
      let reversePath = sharedReversePath(mappingData.reverseKey);
      return existsAfter(reversePath)
        && getAfter(reversePath).data.mappingId == mappingId
        && getAfter(reversePath).data.tmdbId == mappingData.tmdbId
        && getAfter(reversePath).data.mediaType == mappingData.mediaType
        && getAfter(reversePath).data.kpId == mappingData.kpId;
    }

    function hasSharedForwardMapping(reverseKey, lockData) {
      let mappingPath = sharedMappingPath(lockData.mappingId);
      return existsAfter(mappingPath)
        && getAfter(mappingPath).data.reverseKey == reverseKey
        && getAfter(mappingPath).data.tmdbId == lockData.tmdbId
        && getAfter(mappingPath).data.mediaType == lockData.mediaType
        && getAfter(mappingPath).data.kpId == lockData.kpId;
    }
    
    function movieAggregateFields() {
      return [
        'hasCommunityRating',
        'hasRatings',
        'ratingsCount',
        'ratingsSum',
        'avgRating',
        'lastRatingUpdatedAt'
      ];
    }

    function createsMovieWithServerFields() {
      return request.resource.data.keys().hasAny(movieAggregateFields());
    }

    function changesMovieServerFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(movieAggregateFields());
    }

    // Movies collection - read for all, metadata writes for approved users,
    // server-owned aggregate writes through the Cloud Function/Admin SDK only.
    match /movies/{movieId} {
      allow read: if true; // Anyone can read cached movies
      allow create: if isApprovedUser() && !createsMovieWithServerFields();
      allow update: if isApprovedUser() && !changesMovieServerFields();
      allow delete: if isAdmin(); // Only admins can delete movies
    }
    
    // Ratings collection (Top-level)
    match /ratings/{ratingId} {
      allow read: if true; // Anyone can read ratings
      // New documents use one deterministic key per authenticated user/movie.
      // Firestore Rules cannot query for duplicate field pairs, so document ID
      // is the authoritative uniqueness constraint.
      allow create: if isApprovedUser()
        && request.resource.data.userId == request.auth.uid
        && isValidRatingData(request.resource.data)
        && hasCanonicalRatingId(ratingId, request.resource.data);
      // Pre-existing random-ID ratings remain editable by their owner until a
      // separately approved data migration removes or canonicalizes them.
      allow update: if (isApprovedUser() || isAdmin())
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.movieId == resource.data.movieId
        && isValidRatingData(request.resource.data)
        && (!isTextOnlyRatingUpdate() || (
          request.resource.data.rating == resource.data.rating
          && request.resource.data.movieId == resource.data.movieId
          && request.resource.data.userId == resource.data.userId
        ));
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Private episode ratings. A missing deterministic document is readable
    // only by its owner so the first write can use a Firestore transaction.
    match /seriesEpisodeStats/{movieId} {
      allow read: if true;
      allow write: if false;
    }

    match /seriesEpisodeRatings/{seriesRatingId} {
      allow get: if (hasOwnSeriesEpisodeRatingId(seriesRatingId)
          && !exists(seriesEpisodeRatingPath(seriesRatingId)))
        || (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && seriesRatingId == request.auth.uid + '_' + string(resource.data.movieId));
      allow list: if false;
      allow create: if isApprovedUser()
        && hasOwnSeriesEpisodeRatingId(seriesRatingId)
        && isValidSeriesEpisodeRatingData(seriesRatingId, request.resource.data)
        && request.resource.data.episodes.size() == 1
        && request.resource.data.episodes.keys().hasAny([request.resource.data.lastKey])
        && isValidEpisodeRatingEntry(request.resource.data.episodes[request.resource.data.lastKey]);
      allow update: if isApprovedUser()
        && hasOwnSeriesEpisodeRatingId(seriesRatingId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.movieId == resource.data.movieId
        && isValidSeriesEpisodeRatingData(seriesRatingId, request.resource.data)
        && hasOneValidEpisodeRatingChange();
      allow delete: if isApprovedUser()
        && hasOwnSeriesEpisodeRatingId(seriesRatingId)
        && resource.data.userId == request.auth.uid;
    }

    // One deterministic document per user and comment may contain up to three
    // reaction types. Counts are server-derived and never client-writable.
    match /commentReactions/{reactionId} {
      // Transactions must read a missing deterministic document before they can
      // create the user's first reaction. A missing document exposes no data;
      // existing documents still use the owner check below.
      allow get: if hasOwnCommentReactionId(reactionId)
        && !exists(commentReactionPath(reactionId));
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isApprovedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ratingId is string
        && isValidCommentReactionMovieId(request.resource.data.movieId)
        && isValidCommentReactionSelection(request.resource.data)
        && reactionId == request.resource.data.ratingId + '_' + request.auth.uid
        && ratingHasMovie(request.resource.data.ratingId, request.resource.data.movieId);
      allow update: if isApprovedUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.ratingId == resource.data.ratingId
        && string(request.resource.data.movieId) == string(resource.data.movieId)
        && isValidCommentReactionMovieId(request.resource.data.movieId)
        && isValidCommentReactionSelection(request.resource.data)
        && reactionId == request.resource.data.ratingId + '_' + request.auth.uid
        && ratingHasMovie(request.resource.data.ratingId, request.resource.data.movieId);
      allow delete: if isAdmin() || (isApprovedUser() && resource.data.userId == request.auth.uid);
    }

    // Server-maintained counts of users per achievement tier («Есть у N%»).
    match /achievementStats/{statsId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /commentReactionSummaries/{ratingId} {
      allow read: if true;
      allow write: if false;
    }

    // One server-written notification inbox per user (newest reactions on the
    // user's ratings). The owner may only read it with a single document get
    // and stamp it as read; entries are written by Cloud Functions only.
    match /userNotifications/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionsReadAt'])
        && request.resource.data.reactionsReadAt == request.time;
      allow create, delete: if false;
    }

    // The catalog is public read-only configuration. Only admins can publish
    // the allowlisted IDs consumed by reaction writes and client pickers.
    // `cinemaChannel` is the shared «Эфир» broadcast: everyone reads it, only admins
    // publish what is on air. It never holds media, only the item and start time.
    match /settings/{settingId} {
      allow read: if settingId == 'commentReactions' || settingId == 'cinemaChannel';
      allow read: if settingId == 'cinemaScheduleState' && isAdmin();
      allow create, update: if settingId == 'cinemaScheduleState' && isAdmin()
        && request.resource.data.keys().hasOnly(['revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.revision is int
        && request.resource.data.revision > 0 && request.resource.data.revision <= 9007199254740991
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && cinemaScheduleRevisionAdvanced();
      allow create, update: if settingId == 'cinemaChannel'
        && isAdmin()
        && validCinemaChannel(request.resource.data);
      allow create, update: if settingId == 'commentReactions'
        && isAdmin()
        && request.resource.data.reactions is list
        && request.resource.data.reactions.size() > 0
        && request.resource.data.reactions.size() <= 24
        && request.resource.data.reactionTypes is list
        && request.resource.data.reactionTypes.size() == request.resource.data.reactions.size()
        && request.resource.data.maxReactionsPerUser == 3;
      allow delete: if false;
    }
    
    // Every occupancy mutation commits with the shared revision. The client reads
    // it before its fresh overlap query, so concurrent writers must retry together.
    function cinemaScheduleRevisionAdvanced() {
      let statePath = /databases/$(database)/documents/settings/cinemaScheduleState;
      let previous = exists(statePath) ? get(statePath).data.revision : 0;
      let next = getAfter(statePath).data;
      return next.revision is int && next.revision == previous + 1
        && next.updatedAt == request.time && next.updatedBy == request.auth.uid;
    }

    function validCinemaDuration(media) {
      return (!('durationSec' in media) || (media.durationSec is int
          && media.durationSec >= 0 && media.durationSec <= 2147483647))
        && (!('pausedAtSec' in media) || media.pausedAtSec == null
          || (media.pausedAtSec is number && media.pausedAtSec >= 0 && media.pausedAtSec <= 2147483647));
    }

    // Optional episode model: mediaType='tv-series' requires integer season>=0
    // and episode>=1. Title is display-only (max 200); KP remains the root ID.
    function validCinemaEpisode(media) {
      return (!('tmdbId' in media) || (media.tmdbId is int && media.tmdbId > 0 && media.tmdbId <= 9007199254740991))
        && ((!('mediaType' in media) && !media.keys().hasAny(['seasonNumber', 'episodeNumber', 'episodeTitle']))
          || (media.get('mediaType', null) == 'tv-series'
            && media.seasonNumber is int && media.seasonNumber >= 0 && media.seasonNumber <= 9007199254740991
            && media.episodeNumber is int && media.episodeNumber >= 1 && media.episodeNumber <= 9007199254740991
            && (!('episodeTitle' in media) || (media.episodeTitle is string && media.episodeTitle.size() <= 200))));
    }

    function validCinemaMedia(data) {
      return (data.mode == 'off' && data.get('youtube', null) == null && data.get('movie', null) == null)
        || (data.mode == 'youtube' && data.youtube is map && data.get('movie', null) == null
          && data.youtube.keys().hasOnly(['videoId', 'live', 'durationSec', 'pausedAtSec'])
          && data.youtube.videoId is string && data.youtube.videoId.matches('^[A-Za-z0-9_-]{11}$')
          && data.youtube.live is bool && validCinemaDuration(data.youtube)
          && (!data.youtube.live || data.youtube.get('pausedAtSec', null) == null))
        || (data.mode == 'movie' && data.movie is map && data.get('youtube', null) == null
          && data.movie.keys().hasOnly(['kinopoiskId', 'durationSec', 'posterUrl', 'pausedAtSec', 'mediaType', 'seasonNumber', 'episodeNumber', 'episodeTitle', 'tmdbId'])
          && data.movie.kinopoiskId is int && data.movie.kinopoiskId > 0 && data.movie.kinopoiskId <= 9007199254740991
          && validCinemaDuration(data.movie) && validCinemaEpisode(data.movie)
          && (!('posterUrl' in data.movie) || (data.movie.posterUrl is string
            && (data.movie.posterUrl == '' || (data.movie.posterUrl.size() <= 508 && data.movie.posterUrl.matches('^https://[^\\s"\'<>]+$'))))));
    }

    function validCinemaChannel(data) {
      return data.mode in ['off', 'youtube', 'movie']
        && data.title is string && data.title.size() <= 120
        && data.startedAt is timestamp
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && data.keys().hasOnly(['mode', 'title', 'youtube', 'movie', 'startedAt', 'updatedAt', 'updatedBy'])
        && validCinemaMedia(data);
    }

    function validCinemaSchedule(data) {
      return data.mode in ['youtube', 'movie']
        && data.title is string && data.title.size() <= 120
        && data.startedAt is timestamp
        && (!('endsAt' in data) || (data.endsAt is timestamp && data.endsAt > data.startedAt))
        && (!('playbackStartedAt' in data) || data.playbackStartedAt is timestamp)
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && data.keys().hasOnly(['mode', 'title', 'youtube', 'movie', 'startedAt', 'endsAt', 'playbackStartedAt', 'updatedAt', 'updatedBy'])
        && validCinemaMedia(data);
    }

    function cinemaScheduleOccupancyUnchanged() {
      let before = resource.data;
      let after = request.resource.data;
      return before.startedAt == after.startedAt
        && before.get('endsAt', null) == after.get('endsAt', null)
        && before.mode == after.mode
        && ((after.mode == 'youtube' && before.youtube.videoId == after.youtube.videoId
            && before.youtube.live == after.youtube.live
            && (('endsAt' in after) || before.youtube.get('durationSec', 0) == after.youtube.get('durationSec', 0)))
          || (after.mode == 'movie' && before.movie.kinopoiskId == after.movie.kinopoiskId
            && before.movie.get('mediaType', null) == after.movie.get('mediaType', null)
            && before.movie.get('seasonNumber', null) == after.movie.get('seasonNumber', null)
            && before.movie.get('episodeNumber', null) == after.movie.get('episodeNumber', null)
            && (('endsAt' in after) || before.movie.get('durationSec', 0) == after.movie.get('durationSec', 0))));
    }

    // «Эфир» schedule: planned shows that start on their own at `startedAt`.
    // Everyone reads it (the live page resolves what is on air); only admins plan.
    match /cinemaSchedule/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && validCinemaSchedule(request.resource.data)
        && ('endsAt' in request.resource.data) && cinemaScheduleRevisionAdvanced();
      allow update: if isAdmin() && validCinemaSchedule(request.resource.data)
        && (cinemaScheduleOccupancyUnchanged() || cinemaScheduleRevisionAdvanced());
      allow delete: if isAdmin() && cinemaScheduleRevisionAdvanced();
    }

    // «Эфир» fallback relay (WebRTC from the admin's browser). Only signaling lives
    // here: who is relaying, plus one small offer/answer doc per viewer.
    match /liveRelay/{docId} {
      allow read: if isAuthenticated() && docId == 'current';
      allow create, update: if isAdmin() && docId == 'current'
        && request.resource.data.keys().hasOnly(['active', 'sessionId', 'startedAt', 'updatedBy'])
        && request.resource.data.active is bool;
      allow delete: if false;

      match /peers/{viewerId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == viewerId);
        // Viewers may only ask to join or answer; only the admin writes offers.
        allow create, update: if docId == 'current'
          && request.resource.data.keys().hasOnly(['sessionId', 'state', 'offer', 'answer', 'updatedAt'])
          && request.resource.data.sessionId is string
          && (isAdmin()
            || (isAuthenticated() && request.auth.uid == viewerId
                && request.resource.data.state in ['request', 'answered']));
        allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == viewerId);
      }
    }

    // Watchlist collection (Top-level)
    match /watchlist/{watchlistId} {
      allow read: if true; // Anyone can read watchlists
      allow create: if isOwnListEntryCreate() || isAdmin(); // Approved users create only their own entries
      allow update: if isOwnListEntryChange() || isAdmin(); // Owner (userId unchanged) or admin
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Watching collection (Top-level)
    match /watching/{watchingId} {
      allow read: if true; // Anyone can read watching list
      allow create: if isOwnListEntryCreate() || isAdmin(); // Approved users create only their own entries
      allow update: if isOwnListEntryChange() || isAdmin(); // Owner (userId unchanged) or admin
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Favorites collection (Top-level)
    match /favorites/{favoriteId} {
      allow read: if true; // Anyone can read favorites
      allow create: if isOwnListEntryCreate() || isAdmin(); // Approved users create only their own entries
      allow update: if isOwnListEntryChange() || isAdmin(); // Owner (userId unchanged) or admin
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Collections (Top-level)
    // REQUIRED: AdminService queries this top-level collection to count user collections
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isOwnListEntryCreate() || isAdmin();
      allow update: if isOwnListEntryChange() || isAdmin();
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if isValidReportPayload(request.resource.data)
        && (!hasReviewReportTarget(request.resource.data)
          || isValidReviewReport(request.resource.data));
      allow read, update, delete: if isAdmin(); // Only admins can read, update, delete
    }

    // Missing IMDb IDs can be reported by approved clients. The queue is
    // visible and resolvable only to admins; confirmed mappings are readable by
    // clients so TMDB can be queried strictly by IMDb ID.
    match /tmdbFallbackQueue/{movieId} {
      allow create: if isApprovedUser();
      allow read, update, delete: if isAdmin();
    }

    match /tmdbMovieMappings/{movieId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Admin-verified TMDB→Kinopoisk identities are a shared, read-only source
    // for authenticated clients. The client cache is derived from these records.
    match /tmdbKinopoiskMappings/{mappingId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        && isValidSharedIdMapping(mappingId, request.resource.data)
        && hasSharedReverseLock(mappingId, request.resource.data)
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin()
        && isValidSharedIdMapping(mappingId, request.resource.data)
        && hasSharedReverseLock(mappingId, request.resource.data)
        && request.resource.data.confirmedBy == resource.data.confirmedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin()
        && !existsAfter(sharedReversePath(resource.data.reverseKey));
    }

    match /tmdbKinopoiskReverseIndex/{reverseKey} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        && isValidSharedReverseLock(reverseKey, request.resource.data)
        && hasSharedForwardMapping(reverseKey, request.resource.data);
      allow update: if isAdmin()
        && isValidSharedReverseLock(reverseKey, request.resource.data)
        && request.resource.data.mappingId == resource.data.mappingId
        && hasSharedForwardMapping(reverseKey, request.resource.data);
      allow delete: if isAdmin()
        && (!existsAfter(sharedMappingPath(resource.data.mappingId))
          || getAfter(sharedMappingPath(resource.data.mappingId)).data.reverseKey != reverseKey);
    }

    // Provider key metadata is readable only by admins. All writes go through
    // the server-side Secret Manager workflow; clients cannot write metadata,
    // secret references, or raw credentials directly.
    match /systemApiKeys/{keyId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Audit records are server-owned and immutable from client SDKs.
    match /systemApiKeyAuditLogs/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Watch-room data is durable server state. Clients use authenticated HTTPS
    // actions and RTDB's narrow derived ACL; no room document, invitation, or
    // delivery outbox is directly readable or writable from a client SDK.
    match /watchRooms/{roomId} {
      allow read, write: if false;

      match /members/{memberId} {
        allow read, write: if false;
      }
    }

    match /watchRoomInvites/{inviteId} {
      allow read, write: if false;
    }

    match /watchRoomAclOutbox/{eventId} {
      allow read, write: if false;
    }

    match /watchRoomStateOutbox/{eventId} {
      allow read, write: if false;
    }

    match /watchRoomApprovalOutbox/{eventId} {
      allow read, write: if false;
    }

    // The private staging proof uses a separate durable namespace, but retains the
    // same server-only boundary as the production room model.
    match /watchRoomsStaging/{roomId} {
      allow read, write: if false;

      match /members/{memberId} {
        allow read, write: if false;
      }
    }

    match /watchRoomsStagingInvites/{inviteId} {
      allow read, write: if false;
    }

    match /watchRoomsStagingAclOutbox/{eventId} {
      allow read, write: if false;
    }

    match /watchRoomsStagingCreateRequests/{requestId} {
      allow read, write: if false;
    }
    
    // Random-page shared movie marathon. Firestore is the read and subscription
    // surface; every round and item mutation goes through the server endpoint.
    match /randomMarathons/current {
      allow read: if isApprovedUser() || isAdmin();
      allow create, update, delete: if false;

      match /items/{itemId} {
        allow read: if isApprovedUser() || isAdmin();
        // All mutations go through the server-owned randomMarathon function.
        // The function uses the Admin SDK after checking approval, role,
        // schema, participant quota, and the round state transactionally.
        allow create, update, delete: if false;
      }
    }

    // Users collection
    match /users/{userId} {
      // Everyone reads their own profile (the approval check on login runs while
      // still pending); other profiles, including their e-mail field, are readable
      // only by approved users and admins.
      allow read: if isOwner(userId) || isApprovedUser() || isAdmin();
      
      // Allow users to create their own profile, but forbidden from granting themselves admin or approved status.
      // approvalStatus must be present and 'pending': isApprovedUser() treats a missing field as legacy-approved.
      allow create: if isOwner(userId) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        request.resource.data.get('approvalStatus', null) == 'pending' &&
        (!('photoURL' in request.resource.data) || isSafePhotoUrl(request.resource.data.photoURL)) &&
        (!('bannerURL' in request.resource.data) || isSafePhotoUrl(request.resource.data.bannerURL));

      // Allow users to update their own profile (cannot modify isAdmin or approvalStatus).
      // photoURL is rendered on other users' pages, so a changed value must be an image URL.
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'approvalStatus']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) ||
          !('photoURL' in request.resource.data) ||
          isSafePhotoUrl(request.resource.data.photoURL)) &&
        isValidProfileFieldUpdate();
      
      // Allow admins to update any user profile (can change approvalStatus and isAdmin)
      allow update: if isAdmin();
      
      // Allow admins to delete users (except themselves)
      allow delete: if isAdmin() && request.auth.uid != userId;
         
      // --- Subcollections ---
      
      // User Collections Subcollection (if app uses nested structure)
      match /collections/{collectionId} {
        allow read: if true; 
        allow write: if (isApprovedUser() && isOwner(userId)) || isAdmin();
      }
      
      // User Settings Subcollection
      match /settings/{settingId} {
        allow read: if isOwner(userId); 
        allow write: if isOwner(userId); 
      }
      
      // User ratings subcollection (Legacy)
      match /ratings/{ratingId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    // Movie ratings subcollection (Legacy)
    match /movies/{movieId}/ratings/{ratingId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
