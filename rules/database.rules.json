{
  "rules": {
    ".read": false,
    ".write": false,
    "approvedRoomAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "roomAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "roomLive": {
      "$roomId": {
        ".read": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
        "state": {
          ".validate": "!newData.exists() || (newData.hasChildren(['revision', 'contentRevision', 'phase', 'basePositionMs', 'effectiveAtMs', 'updatedBy', 'providerHint', 'contentSnapshot']) && newData.child('revision').isNumber() && newData.child('revision').val() >= 0 && newData.child('contentRevision').isNumber() && newData.child('contentRevision').val() >= 0 && (newData.child('phase').val() === 'loading' || newData.child('phase').val() === 'playing' || newData.child('phase').val() === 'paused' || newData.child('phase').val() === 'ended') && newData.child('basePositionMs').isNumber() && newData.child('basePositionMs').val() >= 0 && newData.child('basePositionMs').val() <= 10000000000 && newData.child('effectiveAtMs').isNumber() && newData.child('effectiveAtMs').val() <= now + 10000 && newData.child('effectiveAtMs').val() >= now - 60000 && newData.child('updatedBy').isString() && newData.child('updatedBy').val().length <= 128 && newData.child('providerHint').isString() && newData.child('providerHint').val().length <= 80 && newData.child('contentSnapshot').hasChildren(['kinopoiskId', 'mediaType', 'contentRevision', 'timelineProfile']))",
          "revision": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && (root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' || root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'controller') && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
            ".validate": "newData.isNumber() && data.isNumber() && newData.val() === data.val() + 1"
          },
          "phase": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && (root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' || root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'controller') && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now && data.val() !== 'ended'",
            ".validate": "newData.val() === 'playing' || newData.val() === 'paused'"
          },
          "basePositionMs": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && (root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' || root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'controller') && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
          },
          "effectiveAtMs": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && (root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' || root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'controller') && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
          },
          "updatedBy": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && (root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' || root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'controller') && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "contentRevision": {
            ".write": false
          },
          "contentSnapshot": {
            ".write": false
          },
          "providerHint": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "providerSource": {
            ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
            ".validate": "!newData.exists() || (newData.parent().child('providerHint').val() === 'rutube' && newData.hasChildren(['version', 'providerId', 'videoId']) && newData.child('version').isNumber() && newData.child('version').val() === 1 && newData.child('providerId').val() === 'rutube' && newData.child('videoId').isString() && newData.child('videoId').val().matches(/^[A-Za-z0-9_-]{8,80}$/))",
            "version": {
              ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            },
            "providerId": {
              ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            },
            "videoId": {
              ".write": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() === 'owner' && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "members": {
          ".write": false
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
            ".validate": "!newData.exists() || (newData.hasChildren(['connectedAtMs', 'role']) && newData.child('connectedAtMs').isNumber() && newData.child('connectedAtMs').val() <= now + 10000 && newData.child('connectedAtMs').val() >= now - 60000 && newData.child('role').isString() && newData.child('role').val() === root.child('roomAccess').child(auth.uid).child($roomId).child('role').val() && (!newData.child('displayName').exists() || (newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 48)))",
            "connectedAtMs": {
              ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            },
            "role": {
              ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            },
            "displayName": {
              ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "readiness": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now && !newData.exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['status', 'code']) && (newData.child('status').val() === 'resolving' || newData.child('status').val() === 'ready' || newData.child('status').val() === 'unavailable') && newData.child('code').isString() && newData.child('code').val().length <= 64)",
            "status": {
              ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            },
            "code": {
              ".write": "auth != null && auth.uid === $uid && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && root.child('roomAccess').child(auth.uid).child($roomId).child('expiresAtMs').val() > now"
            }
          }
        }
      }
    },
    "publicRoomIndex": {
      ".read": "auth != null && root.child('approvedRoomAccess').child(auth.uid).child('approved').val() === true && query.orderByChild === 'sortKey' && query.startAt >= now && query.limitToFirst <= 20",
      ".write": false,
      ".indexOn": ["sortKey"]
    },
    "publicIndexRepairQueue": {
      ".read": false,
      ".write": false,
      ".indexOn": ["nextAttemptAt"]
    },
    "roomRequestGate": {
      ".read": false,
      ".write": false
    },
    "roomRequestResults": {
      ".read": false,
      ".write": false
    }
  }
}
