{
 "manifest_version": 3,
 "name": "dnrlab",
 "version": "1.0",
 "key": "",
 "host_permissions": [
  "http://127.0.0.1/*",
  "http://localhost/*",
  "<all_urls>"
 ],
 "permissions": [
  "declarativeNetRequest",
  "offscreen",
  "declarativeNetRequestFeedback"
 ],
 "background": {
  "service_worker": "sw.js"
 },
 "declarative_net_request": {
  "rule_resources": [
   {
    "id": "private_block",
    "enabled": true,
    "path": "rules.json"
   }
  ]
 }
}