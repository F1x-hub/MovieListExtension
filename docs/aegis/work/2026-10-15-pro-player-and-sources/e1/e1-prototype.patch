diff --git a/src/shared/styles/player.css b/src/shared/styles/player.css
index 6293407..121dd5e 100644
--- a/src/shared/styles/player.css
+++ b/src/shared/styles/player.css
@@ -2063,3 +2063,93 @@ body.player-modal-open {
         border-radius: 16px;
     }
 }
+
+/* E1 unified «Смотреть» entry (flag unifiedWatchEntry). */
+.watch-entry {
+    position: relative;
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    flex: 0 0 auto;
+}
+
+.watch-entry__main,
+.watch-entry__toggle,
+.watch-entry__torrent {
+    height: 36px;
+    padding: 0 13px;
+    color: var(--theme-text-primary);
+    background: transparent;
+    border: 1px solid var(--theme-border);
+    border-radius: 10px;
+    font: 600 13px/1 var(--font-family);
+    cursor: pointer;
+}
+
+.watch-entry__main {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    color: var(--ui-color-page);
+    background: var(--ui-color-interactive);
+    border-color: transparent;
+}
+
+.watch-entry__source {
+    font-weight: 500;
+    opacity: 0.75;
+}
+
+.watch-entry__source:empty {
+    display: none;
+}
+
+.watch-entry__main[aria-busy="true"] {
+    cursor: progress;
+    opacity: 0.8;
+}
+
+.watch-entry__torrent[hidden],
+.source-toolbar__label[hidden] {
+    display: none;
+}
+
+.watch-entry__torrent.active {
+    border-color: var(--theme-text-primary);
+}
+
+.watch-entry button:focus-visible {
+    outline: 2px solid var(--ui-color-interactive);
+    outline-offset: 2px;
+}
+
+.source-popover {
+    position: absolute;
+    top: calc(100% + 6px);
+    left: 0;
+    z-index: 40;
+    min-width: 220px;
+    max-width: min(360px, 90vw);
+    padding: 8px;
+    background: var(--ui-color-surface, #15161a);
+    border: 1px solid var(--theme-border);
+    border-radius: 12px;
+    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
+}
+
+.source-popover[hidden] {
+    display: none;
+}
+
+.source-popover .source-buttons-container {
+    flex-direction: column;
+    max-height: none;
+    overflow: visible;
+}
+
+.source-popover__hint {
+    margin: 8px 4px 0;
+    color: var(--ui-color-content-muted);
+    font-size: 11px;
+    line-height: 1.4;
+}
